#!/usr/bin/env bash

# memtop: lightweight memory process viewer using ps and awk.
#
# Default behavior:
#   Show the top 20 processes sorted by RSS memory size.
#
# Added flags:
#   --no-header, --plain, --self, --hide-self, --tree, --pid PID,
#   --limit-rss=500M, --json, --csv, --log FILE, --once, --width N,
#   --reverse, and --summary.
#
# Color map:
#   PID and %MEM  = bright bold orange
#   RSS           = bright bold yellow
#   USER          = bright bold cyan
#   COMMAND       = bright bold blue

set -o pipefail

num=20
sort_by="rss"
unit="auto"
full=0
color=1
user_filter=""
watch_sec=""
header=1
hide_self=0
tree=0
pid_filter=""
limit_rss_kb=0
output="table"
log_file=""
once=0
width=0
reverse=0
summary=0

usage() {
    cat <<'USAGE_EOF'
memtop - show top memory using processes

Usage:
  memtop [options]

Options:
  -n, --num N          Show N rows. Default: 20.
      --num=N          Same as --num N.
  -s, --sort FIELD     Sort by rss or pmem. Default: rss.
      --sort=FIELD     Same as --sort FIELD.
  -u, --unit UNIT      RSS unit: auto, kb, mb, gb. Default: auto.
      --unit=UNIT      Same as --unit UNIT.
      --user USER      Only show processes owned by USER.
  -f, --full           Show the full command line.
      --no-header      Do not print the table header.
      --plain          Same as --no-color --no-header.
      --self           Hide memtop, ps, and awk from output.
      --hide-self      Same as --self.
      --tree           Add PPID and a light tree indentation.
      --pid PID        Inspect one process ID only.
      --limit-rss SIZE Only show rows at or above SIZE.
      --json           Output JSON.
      --csv            Output CSV.
      --log FILE       Append output snapshots to FILE.
  -w, --watch SEC      Refresh every SEC seconds.
      --once           Run one time, even when --watch is set.
      --width N        Trim command text to N characters.
      --reverse        Reverse sort order.
      --summary        Show displayed RSS and %MEM totals.
      --no-color       Disable ANSI color.
      --color          Force ANSI color.
  -h, --help           Show this help.

Size examples:
  --limit-rss=500M
  --limit-rss=1G
  --limit-rss=250000K

Examples:
  memtop
  memtop --num=10
  memtop --plain
  memtop --json --num=5
  memtop --csv --no-header
  memtop --pid 1928 --full
  memtop --limit-rss=100M --summary
  memtop --watch=2 --hide-self
  memtop --full --width=90
USAGE_EOF
}

die() {
    printf 'memtop: %s\n' "$1" >&2
    exit 1
}

need_value() {
    [[ -n ${2-} && $2 != --* ]] || die "$1 needs a value"
}

parse_size_to_kb() {
    local raw number suffix
    raw=${1:-}

    [[ $raw =~ ^[0-9]+([.][0-9]+)?([KkMmGg])?$ ]] || \
        die 'size must look like 500M, 1G, 250K, or 250000'

    suffix=${raw: -1}
    if [[ $suffix =~ [KkMmGg] ]]; then
        number=${raw%?}
    else
        suffix=K
        number=$raw
    fi

    awk -v n="$number" -v s="$suffix" '
        BEGIN {
            s = toupper(s)
            if (s == "G") {
                printf "%.0f\n", n * 1024 * 1024
            } else if (s == "M") {
                printf "%.0f\n", n * 1024
            } else {
                printf "%.0f\n", n
            }
        }'
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--num)
            need_value "$1" "${2-}"
            num=$2
            shift 2
            ;;
        --num=*)
            num=${1#*=}
            shift
            ;;
        -s|--sort)
            need_value "$1" "${2-}"
            sort_by=$2
            shift 2
            ;;
        --sort=*)
            sort_by=${1#*=}
            shift
            ;;
        -u|--unit)
            need_value "$1" "${2-}"
            unit=$2
            shift 2
            ;;
        --unit=*)
            unit=${1#*=}
            shift
            ;;
        --user)
            need_value "$1" "${2-}"
            user_filter=$2
            shift 2
            ;;
        --user=*)
            user_filter=${1#*=}
            shift
            ;;
        -f|--full)
            full=1
            shift
            ;;
        --no-header)
            header=0
            shift
            ;;
        --plain)
            color=0
            header=0
            shift
            ;;
        --self|--hide-self)
            hide_self=1
            shift
            ;;
        --tree)
            tree=1
            shift
            ;;
        --pid)
            need_value "$1" "${2-}"
            pid_filter=$2
            shift 2
            ;;
        --pid=*)
            pid_filter=${1#*=}
            shift
            ;;
        --limit-rss)
            need_value "$1" "${2-}"
            limit_rss_kb=$(parse_size_to_kb "$2")
            shift 2
            ;;
        --limit-rss=*)
            limit_rss_kb=$(parse_size_to_kb "${1#*=}")
            shift
            ;;
        --json)
            output="json"
            color=0
            shift
            ;;
        --csv)
            output="csv"
            color=0
            shift
            ;;
        --log)
            need_value "$1" "${2-}"
            log_file=$2
            shift 2
            ;;
        --log=*)
            log_file=${1#*=}
            shift
            ;;
        -w|--watch)
            need_value "$1" "${2-}"
            watch_sec=$2
            shift 2
            ;;
        --watch=*)
            watch_sec=${1#*=}
            shift
            ;;
        --once)
            once=1
            shift
            ;;
        --width)
            need_value "$1" "${2-}"
            width=$2
            shift 2
            ;;
        --width=*)
            width=${1#*=}
            shift
            ;;
        --reverse)
            reverse=1
            shift
            ;;
        --summary)
            summary=1
            shift
            ;;
        --no-color)
            color=0
            shift
            ;;
        --color)
            color=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown option: $1"
            ;;
    esac
done

[[ $num =~ ^[0-9]+$ ]] || die '--num must be a positive integer'
(( num > 0 )) || die '--num must be greater than zero'

case "$sort_by" in
    rss|pmem) ;;
    *) die '--sort must be rss or pmem' ;;
esac

case "$unit" in
    auto|kb|mb|gb) ;;
    *) die '--unit must be auto, kb, mb, or gb' ;;
esac

if [[ -n $pid_filter ]]; then
    [[ $pid_filter =~ ^[0-9]+$ ]] || die '--pid must be an integer'
fi

if [[ $width != 0 ]]; then
    [[ $width =~ ^[0-9]+$ ]] || die '--width must be an integer'
fi

if [[ -n $watch_sec ]]; then
    [[ $watch_sec =~ ^[0-9]+([.][0-9]+)?$ ]] || \
        die '--watch must be seconds, such as 2 or 0.5'
fi

run_once_raw() {
    local fields ps_sort self_pid shell_pid now

    fields='pid=,ppid=,pmem=,rss=,user=,comm='
    [[ $full -eq 1 ]] && fields='pid=,ppid=,pmem=,rss=,user=,args='

    ps_sort="-$sort_by"
    [[ $reverse -eq 1 ]] && ps_sort="$sort_by"

    self_pid=$$
    shell_pid=$BASHPID
    now=$(date '+%F %T')

    ps -eo "$fields" --sort="$ps_sort" | \
    awk \
        -v limit="$num" \
        -v unit="$unit" \
        -v only_user="$user_filter" \
        -v color="$color" \
        -v header="$header" \
        -v hide_self="$hide_self" \
        -v self_pid="$self_pid" \
        -v shell_pid="$shell_pid" \
        -v tree="$tree" \
        -v pid_filter="$pid_filter" \
        -v min_rss="$limit_rss_kb" \
        -v output="$output" \
        -v width="$width" \
        -v summary="$summary" \
        -v generated_at="$now" '
        BEGIN {
            reset = ""
            pid_c = ""
            rss_c = ""
            user_c = ""
            cmd_c = ""

            if (color == 1 && output == "table") {
                reset = sprintf("%c[0m", 27)
                pid_c = sprintf("%c[1;38;5;208m", 27)
                rss_c = sprintf("%c[1;33m", 27)
                user_c = sprintf("%c[1;36m", 27)
                cmd_c = sprintf("%c[1;94m", 27)
            }
        }

        function human_rss(kb) {
            if (unit == "kb") {
                return sprintf("%dK", kb)
            }
            if (unit == "mb") {
                return sprintf("%.1fM", kb / 1024)
            }
            if (unit == "gb") {
                return sprintf("%.2fG", kb / 1024 / 1024)
            }
            if (kb >= 1048576) {
                return sprintf("%.2fG", kb / 1024 / 1024)
            }
            if (kb >= 1024) {
                return sprintf("%.1fM", kb / 1024)
            }
            return sprintf("%dK", kb)
        }

        function csv_quote(s) {
            gsub(/"/, "\"\"", s)
            return "\"" s "\""
        }

        function json_quote(s,    out, i, c) {
            out = ""
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\\") {
                    out = out "\\\\"
                } else if (c == "\"") {
                    out = out "\\\""
                } else if (c == "\b") {
                    out = out "\\b"
                } else if (c == "\f") {
                    out = out "\\f"
                } else if (c == "\n") {
                    out = out "\\n"
                } else if (c == "\r") {
                    out = out "\\r"
                } else if (c == "\t") {
                    out = out "\\t"
                } else {
                    out = out c
                }
            }
            return "\"" out "\""
        }

        function trim_cmd(s) {
            if (width > 0 && length(s) > width) {
                if (width <= 3) {
                    return substr(s, 1, width)
                }
                return substr(s, 1, width - 3) "..."
            }
            return s
        }

        function depth(pid,    d, p, seen) {
            d = 0
            p = pid
            while (parent[p] != "" && parent[p] != 0) {
                if (seen[p] == 1) {
                    break
                }
                seen[p] = 1
                p = parent[p]
                d++
                if (d > 8) {
                    break
                }
            }
            return d
        }

        function indent(n,    s, i) {
            s = ""
            for (i = 0; i < n; i++) {
                s = s "  "
            }
            if (n > 0) {
                s = s "|- "
            }
            return s
        }

        function keep_row(i,    cmd) {
            cmd = cmds[i]

            if (only_user != "" && users[i] != only_user) {
                return 0
            }
            if (pid_filter != "" && pids[i] != pid_filter) {
                return 0
            }
            if (min_rss > 0 && rsses[i] < min_rss) {
                return 0
            }
            if (hide_self == 1) {
                if (pids[i] == self_pid || pids[i] == shell_pid) {
                    return 0
                }
                if (cmd ~ /(^|\/)(memtop|ps|awk)( |$)/) {
                    return 0
                }
            }
            return 1
        }

        {
            count++
            pids[count] = $1 + 0
            ppids[count] = $2 + 0
            pmems[count] = $3 + 0
            rsses[count] = $4 + 0
            users[count] = $5
            cmd = $6

            for (i = 7; i <= NF; i++) {
                cmd = cmd " " $i
            }
            if (cmd == "") {
                cmd = "?"
            }

            cmds[count] = cmd
            parent[pids[count]] = ppids[count]
        }

        END {
            if (output == "json") {
                printf "{\n"
                printf "  \"generated_at\": %s,\n", json_quote(generated_at)
                printf "  \"sort\": %s,\n", json_quote("'"$sort_by"'")
                printf "  \"unit\": %s,\n", json_quote(unit)
                printf "  \"processes\": [\n"
            } else if (output == "csv") {
                if (header == 1) {
                    print "pid,ppid,pmem,rss_kb,rss,user,command"
                }
            } else if (header == 1) {
                if (tree == 1) {
                    printf "%s%7s%s %s%7s%s %s%6s%s %s%10s%s " \
                           "%s%-12s%s %s%s%s\n", \
                        pid_c, "PID", reset, pid_c, "PPID", reset, \
                        pid_c, "%MEM", reset, rss_c, "RSS", reset, \
                        user_c, "USER", reset, cmd_c, "COMMAND", reset
                } else {
                    printf "%s%7s%s %s%6s%s %s%10s%s %s%-12s%s " \
                           "%s%s%s\n", \
                        pid_c, "PID", reset, pid_c, "%MEM", reset, \
                        rss_c, "RSS", reset, user_c, "USER", reset, \
                        cmd_c, "COMMAND", reset
                }
            }

            json_seen = 0
            shown = 0
            total_rss = 0
            total_pmem = 0

            for (i = 1; i <= count; i++) {
                if (!keep_row(i)) {
                    continue
                }

                if (shown >= limit) {
                    break
                }
                shown++

                total_rss += rsses[i]
                total_pmem += pmems[i]
                shown_cmd = trim_cmd(cmds[i])

                if (tree == 1 && output == "table") {
                    shown_cmd = indent(depth(pids[i])) shown_cmd
                }

                if (output == "json") {
                    if (json_seen > 0) {
                        printf ",\n"
                    }
                    printf "    {"
                    printf "\"pid\": %d, ", pids[i]
                    printf "\"ppid\": %d, ", ppids[i]
                    printf "\"pmem\": %.1f, ", pmems[i]
                    printf "\"rss_kb\": %d, ", rsses[i]
                    printf "\"rss\": %s, ", json_quote(human_rss(rsses[i]))
                    printf "\"user\": %s, ", json_quote(users[i])
                    printf "\"command\": %s", json_quote(trim_cmd(cmds[i]))
                    printf "}"
                    json_seen++
                } else if (output == "csv") {
                    printf "%d,%d,%.1f,%d,%s,%s,%s\n", \
                        pids[i], ppids[i], pmems[i], rsses[i], \
                        csv_quote(human_rss(rsses[i])), \
                        csv_quote(users[i]), csv_quote(trim_cmd(cmds[i]))
                } else if (tree == 1) {
                    printf "%s%7d%s %s%7d%s %s%6.1f%s %s%10s%s " \
                           "%s%-12s%s %s%s%s\n", \
                        pid_c, pids[i], reset, pid_c, ppids[i], reset, \
                        pid_c, pmems[i], reset, rss_c, \
                        human_rss(rsses[i]), reset, user_c, users[i], \
                        reset, cmd_c, shown_cmd, reset
                } else {
                    printf "%s%7d%s %s%6.1f%s %s%10s%s %s%-12s%s " \
                           "%s%s%s\n", \
                        pid_c, pids[i], reset, pid_c, pmems[i], reset, \
                        rss_c, human_rss(rsses[i]), reset, user_c, \
                        users[i], reset, cmd_c, shown_cmd, reset
                }
            }

            if (output == "json") {
                printf "\n  ],\n"
                printf "  \"count\": %d,\n", shown
                printf "  \"total_rss_kb\": %d,\n", total_rss
                printf "  \"total_rss\": %s,\n", json_quote(human_rss(total_rss))
                printf "  \"total_pmem\": %.1f\n", total_pmem
                printf "}\n"
            } else if (summary == 1 && output == "csv") {
                printf "summary,,,,%s,%s,%s\n", \
                    csv_quote(human_rss(total_rss)), \
                    csv_quote("displayed_processes=" shown), \
                    csv_quote("total_pmem=" sprintf("%.1f", total_pmem))
            } else if (summary == 1) {
                printf "\n"
                printf "Displayed processes: %d\n", shown
                printf "Total displayed RSS: %s (%d KB)\n", \
                    human_rss(total_rss), total_rss
                printf "Total displayed %%MEM: %.1f\n", total_pmem
            }
        }'
}

show_once() {
    if [[ -n $log_file ]]; then
        run_once_raw | tee -a "$log_file"
    else
        run_once_raw
    fi
}

if [[ -n $watch_sec && $once -eq 0 ]]; then
    while true; do
        clear
        if [[ $output == table ]]; then
            printf 'memtop -- top %s by %s -- %s\n\n' \
                "$num" "$sort_by" "$(date '+%F %T')"
        fi
        show_once
        sleep "$watch_sec"
    done
else
    show_once
fi
